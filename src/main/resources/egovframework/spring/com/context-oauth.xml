<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
        
	<!-- GOOGLE OAuth Configuration -->
	<bean id="googleAuthVO" class="egovframework.com.ext.oauth.service.OAuthVO">
		<constructor-arg value="google" /><!-- Service Name -->
		<constructor-arg value="${Globals.google.client.id}" /><!-- googleClientID -->
		<constructor-arg value="${Globals.google.client.secret}" /><!-- googleClientSecret -->
		<constructor-arg value="${Globals.google.redirect.url}" /><!-- googleRedirectUrl -->
		<constructor-arg value="profile email" /><!-- googleScope -->
	</bean>
	
	<!-- NAVER OAuth Configuration -->
	<bean id="naverAuthVO" class="egovframework.com.ext.oauth.service.OAuthVO">
		<constructor-arg value="naver" /><!-- Service Name -->
		<constructor-arg value="${Globals.naver.client.id}" /><!-- naverClientID -->
		<constructor-arg value="${Globals.naver.client.secret}" /><!-- naverClientSecret -->
		<constructor-arg value="${Globals.naver.redirect.url}" /><!-- naverRedirectUrl -->
		<constructor-arg value = "profile" /><!-- naverScope -->
	</bean>
	
	<!-- KAKAO OAuth Configuration -->
	<bean id="kakaoAuthVO" class="egovframework.com.ext.oauth.service.OAuthVO">
		<constructor-arg value="kakao" /><!-- Service Name -->
		<constructor-arg value="${Globals.kakao.client.id}" /><!-- kakaoClientID -->
		<constructor-arg value="${Globals.kakao.client.secret}" /><!-- kakaoClientSecret -->
		<constructor-arg value="${Globals.kakao.redirect.url}" /><!-- kakaoRedirectUrl -->
		<constructor-arg value ="profile_nickname account_email" /><!-- kakaoScope -->
	</bean>
    
</beans>
